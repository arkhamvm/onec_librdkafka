# Single source of truth for the dockerised test broker.
#
# docker compose automatically picks this file up because it sits next to
# compose.yml; gen-certs.sh / up.sh / down.sh source it explicitly.
# Change a value here and it propagates to the certificates, the broker
# configuration and the helper scripts at once.

# --- Kafka image -------------------------------------------------------------
# Must be a real 4.x tag. Verified against
#   https://hub.docker.com/v2/repositories/apache/kafka/tags
# 4.3.1 is the newest GA (non-rc) 4.x release, digest
#   sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837
#
# up.sh does NOT take this on trust: after the broker is healthy it asks the
# running container for its real version (kafka-topics.sh --version) and dies
# unless the major version equals KAFKA_TEST_EXPECT_BROKER_MAJOR (default 4).
# Setting a 3.x tag here therefore fails the run instead of quietly testing the
# wrong broker.
KAFKA_IMAGE_TAG=4.3.1

# --- Ports (host == container, so advertised.listeners stays truthful) --------
KAFKA_PLAINTEXT_PORT=9092
KAFKA_SSL_PORT=9093

# --- TLS ---------------------------------------------------------------------
# The one and only password. Protects the PKCS#12 bundle, the JKS keystore,
# the private key inside it and the JKS truststore. This is a throwaway test
# CA living in a gitignored directory - it is deliberately not a secret.
KAFKA_CERT_PASSWORD=onec-kafka-test

# Hostnames / addresses baked into the broker certificate (CN + SAN).
# "localhost" and "127.0.0.1" are what the host-side test binary connects to;
# "kafka" is the compose service name, used from inside the docker network.
KAFKA_CERT_CN=localhost
KAFKA_CERT_SAN=DNS:localhost,DNS:kafka,IP:127.0.0.1
KAFKA_CERT_DAYS=3650

# --- Cluster -----------------------------------------------------------------
# Fixed KRaft cluster id so a re-created volume does not surprise anyone.
# Must be a base64 UUID (22 chars) - produced by `kafka-storage.sh random-uuid`.
KAFKA_CLUSTER_ID=n4BileuKRYK1ODgbiLzSJw

# Topic created by the init step (also reachable via auto-creation).
#
# This MUST stay equal to the default baked into tests/kafka_ssl_test.cpp
# (buildConfig(): envOr("KAFKA_TEST_TOPIC", "onec-librdkafka-ssl-test")).
# When the two drifted apart the init step created one topic and the test used
# another, and the run only passed because KAFKA_AUTO_CREATE_TOPICS_ENABLE is
# "true" - i.e. the init step proved nothing. run-tests.sh exports this value
# to the test binary so both ends keep using the same name.
KAFKA_TEST_TOPIC=onec-librdkafka-ssl-test
